; A fake Godot 4 project for the ui-preview example pages: just enough for GodotTheme and apply_godot.py.

config_version=5

[application]

config/name="Sample"
config/features=PackedStringArray("4.3", "C#")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://ui/theme.tres"
